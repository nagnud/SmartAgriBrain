{
  "crop": "tomato",

  "environmental_thresholds": {
    "temperature": {
      "optimal": [20, 28],
      "warning": 30,
      "danger": 35
    },

    "humidity": {
      "optimal": [55, 70],
      "warning": 85
    },

    "pressure": {
      "normal": [1000, 1030]
    }
  },

  "diseases": [
    {
      "name": "霜霉病",
      "risk_condition": "湿度高于85%，温度20~25℃",
      "symptom": "叶片出现黄色斑点，背面产生灰白色霉层",
      "suggestion": [
        "降低棚内湿度",
        "加强通风",
        "喷施对应杀菌剂"
      ]
    },
    {
      "name": "灰霉病",
      "risk_condition": "湿度持续偏高",
      "symptom": "叶片及果实出现灰色霉层",
      "suggestion": [
        "减少浇水",
        "加强空气流通"
      ]
    }
  ],

  "device_rules": {
    "high_temperature": {
      "condition": "temperature > 30",
      "command": "fan_on"
    },

    "low_temperature": {
      "condition": "temperature < 18",
      "command": "fan_off"
    },

    "high_humidity": {
      "condition": "humidity > 85",
      "command": "fan_on"
    }
  }
}