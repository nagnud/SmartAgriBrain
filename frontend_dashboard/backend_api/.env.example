API_HOST=0.0.0.0
API_PORT=8000

# OpenAI/Whisper compatible speech-to-text API.
# You can use SPEECH_TRANSCRIBE_API_KEY, or OPENAI_API_KEY as a fallback.
SPEECH_TRANSCRIBE_BASE_URL=https://api.openai.com/v1
SPEECH_TRANSCRIBE_API_KEY=your_speech_to_text_api_key_here
SPEECH_TRANSCRIBE_MODEL=whisper-1
SPEECH_TRANSCRIBE_TIMEOUT_SECONDS=45
