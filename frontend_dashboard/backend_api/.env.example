API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./smartagribrain.db
DEFAULT_DEVICE_ID=sensairshuttle_001
DEFAULT_DEVICE_NAME=一号大棚设备
DEVICE_OFFLINE_SECONDS=120
DEVICE_MONITOR_INTERVAL_SECONDS=30
DEVICE_MONITOR_ENABLED=true

# Optional MQTT transport. HTTP remains the default and continues to work unchanged.
MQTT_ENABLED=false
DEVICE_COMMAND_TRANSPORT=http
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CA_CERT=
MQTT_CLIENT_ID=
MQTT_TOPIC_PREFIX=smartagribrain/v1
MQTT_QOS=1
MQTT_KEEPALIVE_SECONDS=60
MQTT_COMMAND_TTL_SECONDS=30

# DeepSeek compatible chat completions API for AI farm advice and assistant chat.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_THINKING=disabled

# Online agricultural knowledge sources. Public sources keep no local full-text copy.
AGRI_ONLINE_ENABLED=true
AGRI_SOURCE_TIMEOUT_SECONDS=6
AGRI_TOTAL_TIMEOUT_SECONDS=12
AGRI_CACHE_SECONDS=1800
AGRI_MAX_RESULTS=5
EPPO_API_KEY=

# Ark/Volcengine vision API for crop image analysis.
VISION_PROVIDER=ark
VISION_API_KEY=your-vision-api-key
VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VISION_MODEL=doubao-seed-2-0-mini-260428
VISION_TIMEOUT_SECONDS=90

# Seniverse weather API for current weather, forecasts, air quality and alerts.
SENIVERSE_KEY=your_seniverse_key_here
WEATHER_CITY=无锡
WEATHER_LANGUAGE=zh-Hans
WEATHER_UNIT=c
WEATHER_TIMEOUT_SECONDS=10
WEATHER_CACHE_SECONDS=600

# Voice input is handled directly in the browser with the Web Speech API.
# No backend speech-to-text API key is required.
