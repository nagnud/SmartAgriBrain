API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./smartagribrain.db
DEFAULT_DEVICE_ID=greenhouse_001_s3
DEFAULT_DEVICE_NAME=一号大棚设备
DEFAULT_SITE_ID=greenhouse_001
# Historical protocol key and ID retained for compatibility. The physical board is a regular ESP32.
S3_DEVICE_ID=greenhouse_001_s3
C5_DEVICE_ID=greenhouse_001_c5
DEVICE_OFFLINE_SECONDS=120
DEVICE_MONITOR_INTERVAL_SECONDS=30
DEVICE_MONITOR_ENABLED=true

# EMQX cloud MQTT transport. Do not configure a local Mosquitto Broker.
# Keep real credentials only in the ignored backend_api/.env.mqtt.local file.
MQTT_ENABLED=true
DEVICE_COMMAND_TRANSPORT=mqtt
MQTT_URI=mqtts://your-emqx-host:8883
MQTT_USERNAME=
MQTT_PASSWORD=
# MQTT_URI selects the transport: mqtts means TLS; mqtt means explicit non-TLS.
MQTT_TLS=true
MQTT_CA_CERT=
MQTT_TLS_INSECURE=false
MQTT_CLIENT_ID=smartagribrain-api
MQTT_TOPIC_PREFIX=smartagribrain/v1
MQTT_QOS=1
MQTT_KEEPALIVE_SECONDS=60
MQTT_COMMAND_TTL_SECONDS=30

# Generated locally by scripts/setup/configure-emqx.ps1 (never commit passwords).
# The generated backend_api/.env.mqtt.local overrides these values.

# DeepSeek compatible chat completions API for AI farm advice and assistant chat.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_THINKING=disabled

# Online agricultural knowledge sources. Public sources keep no local full-text copy.
AGRI_ONLINE_ENABLED=true
AGRI_SOURCE_TIMEOUT_SECONDS=6
AGRI_TOTAL_TIMEOUT_SECONDS=12
AGRI_CACHE_SECONDS=1800
AGRI_MAX_RESULTS=5
EPPO_API_KEY=

# Ark/Volcengine vision API for crop image analysis.
VISION_PROVIDER=ark
VISION_API_KEY=your-vision-api-key
VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VISION_MODEL=doubao-seed-2-0-mini-260428
VISION_TIMEOUT_SECONDS=90

# Seniverse weather API for current weather, forecasts, air quality and alerts.
SENIVERSE_KEY=your_seniverse_key_here
WEATHER_CITY=无锡
WEATHER_LANGUAGE=zh-Hans
WEATHER_UNIT=c
WEATHER_TIMEOUT_SECONDS=10
WEATHER_CACHE_SECONDS=600

# Volcengine Doubao speech services for the ESP32-C5 voice assistant.
# Use the legacy console APP ID and Access Token. Never commit real credentials.
VOLC_SPEECH_APP_ID=your-volcengine-speech-app-id
VOLC_SPEECH_ACCESS_TOKEN=your-volcengine-speech-access-token
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLC_ASR_WEBSOCKET_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VOLC_ASR_SAMPLE_RATE_HZ=16000
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_VOICE_TYPE=zh_female_vv_uranus_bigtts
VOLC_TTS_SAMPLE_RATE_HZ=24000
VOLC_TTS_HTTP_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOLC_SPEECH_TIMEOUT_SECONDS=45
